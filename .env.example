# Beispiel-Konfiguration für Docker Compose und den Synology Container Manager.
# Kopiere die Datei nach ".env". Alles hier ist optional.
# Integrationswerte sind nur VORGABEN: Was du in der App unter "Einstellungen" einträgst, hat immer Vorrang.
# Die Beispielwerte sind auskommentiert (#) – entferne das "#" nur bei Zeilen, die du wirklich vorgeben willst.

# Host-Port und Zeitzone für docker-compose.generic.yml.
# HOMEAPP_PORT=8095
# TZ=Europe/Berlin

# Zugriffsschutz der App (HTTP Basic Auth) – dringend empfohlen, wenn die App aus dem Internet erreichbar ist
APP_USER=
APP_PASSWORD=

# HTTPS ist standardmäßig aktiv (auch bei leerem Wert); false/0/no/off schaltet auf HTTP um.
# HTTPS=false
# Optional: eigene Zertifikatsdateien, Pfade innerhalb des Containers.
# Standard: /data/certs/cert.pem und /data/certs/key.pem; fehlen sie, werden sie selbstsigniert erzeugt.
# TLS_CERT=/data/certs/cert.pem
# TLS_KEY=/data/certs/key.pem

# ioBroker
# IOBROKER_HOST=192.168.1.10
# IOBROKER_PORT=8081
# IOBROKER_SECURE=1
# IOBROKER_PROTOCOL=ws
# IOBROKER_USER=
# IOBROKER_PASSWORD=
# IOBROKER_VERIFY_SSL=0

# Synology Surveillance Station
# SS_HOST=192.168.1.5
# SS_PORT=5000
# SS_HTTPS=0
# SS_ACCOUNT=
# SS_PASSWORD=
# SS_VERIFY_SSL=0

# Synology-Legacy-Update aus GitHub (README → Variante C, nur für docker-compose.ghcr.yml)
# Zugriffstoken (classic) mit ausschließlich "read:packages"; leer lassen, wenn das Package öffentlich ist.
# Diese Werte liest nur das Update-Skript im Aufgabenplaner, sie gelangen nicht in den Container.
GHCR_USER=
GHCR_TOKEN=
# Nur bei einem anderen Konto/Repository ändern:
# HOMEAPP_IMAGE=ghcr.io/<konto>/<repository>:latest
