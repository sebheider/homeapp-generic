# Build context of Dockerfile (builds everything) and Dockerfile.prebuilt (copies prebuilt files).
# server/node_modules and client/dist stay in the context: Dockerfile.prebuilt needs them, the normal
# Dockerfile installs and builds its own and ignores them.
.git
.github
.vscode
client/node_modules
data
docs
examples
kiosk-agent
*.log
*.zip
.env
.env.*
